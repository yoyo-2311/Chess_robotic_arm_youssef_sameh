        <material name="marker_a1"/>
      </visual>
    </link>
    <joint name="board_a1_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_a1"/>
      <origin xyz="${-3.5*board_square_x} ${-3.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_h8">
