<xacro:macro name="chess_support" params="parent">
<xacro:if value="${geometry['support']['enabled']}">
<link name="chess_support_link"><visual><geometry><box size="${geometry['support']['size'][0]} ${geometry['support']['size'][1]} ${geometry['support']['size'][2]}"/></geometry><material name="board_wood"/></visual><collision><geometry><box size="${geometry['support']['size'][0]} ${geometry['support']['size'][1]} ${geometry['support']['size'][2]}"/></geometry></collision></link>
<joint name="chess_support_joint" type="fixed"><parent link="${parent}"/><child link="chess_support_link"/><origin xyz="${geometry['support']['position'][0]} ${geometry['support']['position'][1]} ${geometry['support']['position'][2]}" rpy="${geometry['support']['rpy'][0]} ${geometry['support']['rpy'][1]} ${geometry['support']['rpy'][2]}"/></joint>
</xacro:if></xacro:macro></robot>
