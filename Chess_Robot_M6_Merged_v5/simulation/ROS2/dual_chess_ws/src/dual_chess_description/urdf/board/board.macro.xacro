    </link>
    <joint name="board_square_b4_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_b4"/>
      <origin xyz="${-2.5*board_square_x} ${-0.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_c4">
      <visual name="square_c4_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_c4_joint" type="fixed">
