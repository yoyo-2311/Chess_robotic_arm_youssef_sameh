<?xml version="1.0"?>
<!-- Central simulation geometry; all physical measurements remain provisional. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:arg name="geometry_file" default="$(find dual_chess_description)/config/chess_geometry.yaml"/>
<xacro:property name="geometry" value="${xacro.load_yaml('$(arg geometry_file)')}"/>
<xacro:property name="board_length" value="${geometry['board']['length']}"/>
<xacro:property name="board_width" value="${geometry['board']['width']}"/>
<xacro:property name="board_square_x" value="${(board_length-2*geometry['board']['border_x'])/8 if geometry['board']['grid_mode']=='fit_board' else geometry['board']['square_size_x']}"/>
<xacro:property name="board_square_y" value="${(board_width-2*geometry['board']['border_y'])/8 if geometry['board']['grid_mode']=='fit_board' else geometry['board']['square_size_y']}"/>
<xacro:property name="board_size" value="${board_length}"/>
<xacro:property name="board_play_size" value="${8*board_square_x}"/>
<xacro:property name="board_square" value="${board_square_x}"/>
<xacro:property name="board_thickness" value="${geometry['board']['thickness']}"/>
<xacro:property name="board_play_surface_height" value="${geometry['board']['surface_height']}"/>
<xacro:property name="board_rim_x" value="${(board_length-8*board_square_x)/2}"/>
<xacro:property name="board_rim_y" value="${(board_width-8*board_square_y)/2}"/>
<xacro:property name="board_rim_width" value="${board_rim_x}"/>
<xacro:property name="robot_base_offset" value="${-geometry['mounts']['robot1']['position'][1]}"/>
</robot>
