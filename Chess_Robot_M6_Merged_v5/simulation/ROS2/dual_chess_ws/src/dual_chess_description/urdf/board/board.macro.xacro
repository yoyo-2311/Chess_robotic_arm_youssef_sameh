<?xml version="1.0"?>
<!-- Configurable board primitives follow the centralized YAML independently in X/Y.
     board_link is at the underside; chess_board/board_surface is the playing plane.
     The original CAD board mesh remains in meshes/chess_board for reference. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find dual_chess_description)/urdf/board/board_params_cad.xacro"/>

  <xacro:macro name="chess_board" params="parent">
    <xacro:property name="cad_workcell" value="${geometry.get('workcell',dict()).get('enabled',False)}"/>
    <link name="board_link">
      <visual name="board_configurable_visual">
      <xacro:if value="${cad_workcell}"><origin xyz="0 0 ${board_play_surface_height}" rpy="1.5707963267948966 0 0"/><geometry><mesh filename="package://chess_workcell_description/meshes/chess_board.STL"/></geometry></xacro:if>
      <xacro:unless value="${cad_workcell}"><origin xyz="0 0 ${board_play_surface_height/2}"/><geometry><box size="${board_length} ${board_width} ${board_play_surface_height}"/></geometry></xacro:unless>
      <material name="board_wood"/></visual>
      <xacro:if value="${board_rim_x > 0 and board_thickness > board_play_surface_height}"><visual name="rim_left_visual"><origin xyz="${-board_length/2+board_rim_x/2} 0 ${(board_thickness+board_play_surface_height)/2}"/><geometry><box size="${board_rim_x} ${board_width} ${board_thickness-board_play_surface_height}"/></geometry><material name="board_wood"/></visual></xacro:if>
      <xacro:if value="${board_rim_x > 0 and board_thickness > board_play_surface_height}"><visual name="rim_right_visual"><origin xyz="${board_length/2-board_rim_x/2} 0 ${(board_thickness+board_play_surface_height)/2}"/><geometry><box size="${board_rim_x} ${board_width} ${board_thickness-board_play_surface_height}"/></geometry><material name="board_wood"/></visual></xacro:if>
      <xacro:if value="${board_rim_y > 0 and board_thickness > board_play_surface_height}"><visual name="rim_front_visual"><origin xyz="0 ${-board_width/2+board_rim_y/2} ${(board_thickness+board_play_surface_height)/2}"/><geometry><box size="${8*board_square_x} ${board_rim_y} ${board_thickness-board_play_surface_height}"/></geometry><material name="board_wood"/></visual></xacro:if>
      <xacro:if value="${board_rim_y > 0 and board_thickness > board_play_surface_height}"><visual name="rim_back_visual"><origin xyz="0 ${board_width/2-board_rim_y/2} ${(board_thickness+board_play_surface_height)/2}"/><geometry><box size="${8*board_square_x} ${board_rim_y} ${board_thickness-board_play_surface_height}"/></geometry><material name="board_wood"/></visual></xacro:if>
      <!-- Board squares are separate fixed child links below. RViz may apply the
           first material to all visuals if they share a single URDF link. -->
      <!-- Collision uses a simplified foundation (z=0..10 mm). -->
      <collision name="playing_area_collision">
        <xacro:if value="${cad_workcell}"><origin xyz="0 0 ${board_play_surface_height}" rpy="1.5707963267948966 0 0"/><geometry><mesh filename="package://chess_workcell_description/meshes/chess_board.STL"/></geometry></xacro:if>
        <xacro:unless value="${cad_workcell}"><origin xyz="0 0 ${board_play_surface_height/2}"/><geometry><box size="${board_length} ${board_width} ${board_play_surface_height}"/></geometry></xacro:unless>
      </collision>
      <!-- Four raised perimeter rails, preserving the 35cm playing area. -->
      <xacro:if value="${board_rim_x > 0 and board_thickness > board_play_surface_height}"><collision name="rim_left_collision">
        <origin xyz="${-board_length/2 + board_rim_x/2} 0 ${(board_thickness+board_play_surface_height)/2}"/>
        <geometry><box size="${board_rim_x} ${board_width} ${board_thickness - board_play_surface_height}"/></geometry>
      </collision></xacro:if>
      <xacro:if value="${board_rim_x > 0 and board_thickness > board_play_surface_height}"><collision name="rim_right_collision">
        <origin xyz="${board_length/2 - board_rim_x/2} 0 ${(board_thickness+board_play_surface_height)/2}"/>
        <geometry><box size="${board_rim_x} ${board_width} ${board_thickness - board_play_surface_height}"/></geometry>
      </collision></xacro:if>
      <xacro:if value="${board_rim_y > 0 and board_thickness > board_play_surface_height}"><collision name="rim_front_collision">
        <origin xyz="0 ${-board_width/2 + board_rim_y/2} ${(board_thickness+board_play_surface_height)/2}"/>
        <geometry><box size="${8*board_square_x} ${board_rim_y} ${board_thickness - board_play_surface_height}"/></geometry>
      </collision></xacro:if>
      <xacro:if value="${board_rim_y > 0 and board_thickness > board_play_surface_height}"><collision name="rim_back_collision">
        <origin xyz="0 ${board_width/2 - board_rim_y/2} ${(board_thickness+board_play_surface_height)/2}"/>
        <geometry><box size="${8*board_square_x} ${board_rim_y} ${board_thickness - board_play_surface_height}"/></geometry>
      </collision></xacro:if>

      <!-- The CAD material/density is UNKNOWN. This 1kg inertia is provisional.
           As before, board_link must keep an inertial to survive SDF fixed-link
           conversion and keep its attached reference-frame graph connected. -->
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="${(board_width*board_width+board_thickness*board_thickness)/12.0}" ixy="0" ixz="0"
                 iyy="${(board_length*board_length+board_thickness*board_thickness)/12.0}" iyz="0"
                 izz="${(board_length*board_length+board_width*board_width)/12.0}"/>
      </inertial>
    </link>

    <joint name="board_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="board_link"/>
      <!-- Board rests on world z=0; link origin at the board vertical centre. -->
      <origin xyz="${geometry['board']['position'][0]} ${geometry['board']['position'][1]} ${geometry['board']['position'][2]}" rpy="${geometry['board']['rpy'][0]} ${geometry['board']['rpy'][1]} ${geometry['board']['rpy'][2]}"/>
    </joint>

    <!-- Chessboard frame at the ACTUAL playing-square top plane z=10mm;
         raised outer frame reaches z=20.1892mm. -->
    <link name="board_surface"/>
    <joint name="board_surface_joint" type="fixed">
      <parent link="board_link"/>
      <child link="board_surface"/>
      <origin xyz="0 0 ${board_play_surface_height}" rpy="0 0 0"/>
    </joint>

    <!-- 64 checkerboard squares. One visual per fixed link: both RViz and Gazebo
         can render the two materials separately. All are DISPLAY-ONLY:
         no extra collisions, no changes to original CAD mesh or square coords.
         Parent frame board_surface = physical 10 mm playing surface. -->
    <xacro:property name="square_visual_size" value="${board_square_x*0.985}"/>
    <xacro:property name="square_visual_height" value="0.0008"/>
    <xacro:property name="square_visual_above_surface" value="0.0002"/>

    <link name="board_square_a1">
      <visual name="square_a1_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_dark"/>
      </visual>
    </link>
    <joint name="board_square_a1_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_a1"/>
      <origin xyz="${-3.5*board_square_x} ${-3.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_b1">
      <visual name="square_b1_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_b1_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_b1"/>
      <origin xyz="${-2.5*board_square_x} ${-3.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_c1">
      <visual name="square_c1_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_dark"/>
      </visual>
    </link>
    <joint name="board_square_c1_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_c1"/>
      <origin xyz="${-1.5*board_square_x} ${-3.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_d1">
      <visual name="square_d1_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_d1_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_d1"/>
      <origin xyz="${-0.5*board_square_x} ${-3.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_e1">
      <visual name="square_e1_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_dark"/>
      </visual>
    </link>
    <joint name="board_square_e1_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_e1"/>
      <origin xyz="${0.5*board_square_x} ${-3.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_f1">
      <visual name="square_f1_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_f1_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_f1"/>
      <origin xyz="${1.5*board_square_x} ${-3.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_g1">
      <visual name="square_g1_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_dark"/>
      </visual>
    </link>
    <joint name="board_square_g1_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_g1"/>
      <origin xyz="${2.5*board_square_x} ${-3.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_h1">
      <visual name="square_h1_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_h1_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_h1"/>
      <origin xyz="${3.5*board_square_x} ${-3.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_a2">
      <visual name="square_a2_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_a2_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_a2"/>
      <origin xyz="${-3.5*board_square_x} ${-2.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_b2">
      <visual name="square_b2_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_dark"/>
      </visual>
    </link>
    <joint name="board_square_b2_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_b2"/>
      <origin xyz="${-2.5*board_square_x} ${-2.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_c2">
      <visual name="square_c2_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_c2_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_c2"/>
      <origin xyz="${-1.5*board_square_x} ${-2.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_d2">
      <visual name="square_d2_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_dark"/>
      </visual>
    </link>
    <joint name="board_square_d2_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_d2"/>
      <origin xyz="${-0.5*board_square_x} ${-2.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_e2">
      <visual name="square_e2_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_e2_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_e2"/>
      <origin xyz="${0.5*board_square_x} ${-2.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_f2">
      <visual name="square_f2_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_dark"/>
      </visual>
    </link>
    <joint name="board_square_f2_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_f2"/>
      <origin xyz="${1.5*board_square_x} ${-2.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_g2">
      <visual name="square_g2_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_g2_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_g2"/>
      <origin xyz="${2.5*board_square_x} ${-2.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_h2">
      <visual name="square_h2_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_dark"/>
      </visual>
    </link>
    <joint name="board_square_h2_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_h2"/>
      <origin xyz="${3.5*board_square_x} ${-2.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_a3">
      <visual name="square_a3_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_dark"/>
      </visual>
    </link>
    <joint name="board_square_a3_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_a3"/>
      <origin xyz="${-3.5*board_square_x} ${-1.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_b3">
      <visual name="square_b3_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_b3_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_b3"/>
      <origin xyz="${-2.5*board_square_x} ${-1.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_c3">
      <visual name="square_c3_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_dark"/>
      </visual>
    </link>
    <joint name="board_square_c3_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_c3"/>
      <origin xyz="${-1.5*board_square_x} ${-1.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_d3">
      <visual name="square_d3_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_d3_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_d3"/>
      <origin xyz="${-0.5*board_square_x} ${-1.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_e3">
      <visual name="square_e3_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_dark"/>
      </visual>
    </link>
    <joint name="board_square_e3_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_e3"/>
      <origin xyz="${0.5*board_square_x} ${-1.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_f3">
      <visual name="square_f3_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_f3_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_f3"/>
      <origin xyz="${1.5*board_square_x} ${-1.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_g3">
      <visual name="square_g3_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_dark"/>
      </visual>
    </link>
    <joint name="board_square_g3_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_g3"/>
      <origin xyz="${2.5*board_square_x} ${-1.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_h3">
      <visual name="square_h3_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_h3_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_h3"/>
      <origin xyz="${3.5*board_square_x} ${-1.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_a4">
      <visual name="square_a4_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
        <material name="square_light"/>
      </visual>
    </link>
    <joint name="board_square_a4_joint" type="fixed">
      <parent link="board_surface"/>
      <child link="board_square_a4"/>
      <origin xyz="${-3.5*board_square_x} ${-0.5*board_square_y} 0" rpy="0 0 0"/>
    </joint>

    <link name="board_square_b4">
      <visual name="square_b4_visual">
        <origin xyz="0 0 ${square_visual_above_surface+square_visual_height/2}" rpy="0 0 0"/>
        <geometry><box size="${board_square_x*0.985} ${board_square_y*0.985} ${square_visual_height}"/></geometry>
