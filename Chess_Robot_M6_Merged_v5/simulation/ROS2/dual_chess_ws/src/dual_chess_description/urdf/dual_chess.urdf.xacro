<?xml version="1.0"?>
<robot name="dual_chess" xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:arg name="robot1_enabled" default="true"/><xacro:arg name="robot2_enabled" default="true"/>
<xacro:arg name="sim_gazebo" default="false"/><xacro:arg name="use_meshes" default="true"/>
<xacro:arg name="hardware_mode" default="none"/>
<xacro:include filename="$(find dual_chess_description)/urdf/common/materials.xacro"/>
<xacro:include filename="$(find dual_chess_description)/urdf/board/board.macro.xacro"/>
<xacro:include filename="$(find dual_chess_description)/urdf/arm/scara_v2.macro.xacro"/>
<link name="world"/><xacro:chess_board parent="world"/>
<xacro:if value="$(arg robot1_enabled)"><xacro:scara_chess_arm prefix="robot1_" parent="world" x="0" y="${-robot_base_offset}" yaw="${pi/2}"/></xacro:if>
<xacro:if value="$(arg robot2_enabled)"><xacro:scara_chess_arm prefix="robot2_" parent="world" x="0" y="${robot_base_offset}" yaw="${-pi/2}"/></xacro:if>
<xacro:if value="${'$(arg hardware_mode)' == 'mock'}">
<xacro:if value="$(arg robot1_enabled)"><xacro:scara_control prefix="robot1_" hardware="mock_components/GenericSystem"/></xacro:if>
<xacro:if value="$(arg robot2_enabled)"><xacro:scara_control prefix="robot2_" hardware="mock_components/GenericSystem"/></xacro:if>
</xacro:if>
<xacro:if value="$(arg sim_gazebo)">
<gazebo><plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/></gazebo>
<xacro:if value="$(arg robot1_enabled)"><xacro:scara_cmd_pos prefix="robot1_" ns="robot1"/></xacro:if>
<xacro:if value="$(arg robot2_enabled)"><xacro:scara_cmd_pos prefix="robot2_" ns="robot2"/></xacro:if>
</xacro:if>
</robot>
