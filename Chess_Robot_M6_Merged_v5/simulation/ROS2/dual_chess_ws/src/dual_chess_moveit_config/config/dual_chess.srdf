<robot name="dual_chess">
  <group name="robot1">
    <chain base_link="robot1_base_link" tip_link="robot1_tool0" />
  </group>
  <group_state name="home" group="robot1">
    <joint name="robot1_joint1" value="0.09" />
    <joint name="robot1_joint2" value="0.0" />
    <joint name="robot1_joint3" value="0.0" />
  </group_state>
  <disable_collisions link1="robot1_base_link" link2="robot1_link1" reason="Adjacent" />
  <disable_collisions link1="robot1_link1" link2="robot1_link2" reason="Adjacent" />
  <disable_collisions link1="robot1_link2" link2="robot1_link3" reason="Adjacent" />
  <disable_collisions link1="robot1_link3" link2="robot1_link4" reason="Adjacent" />
  <disable_collisions link1="robot1_link4" link2="robot1_link5" reason="Adjacent" />
  <group name="robot2">
    <chain base_link="robot2_base_link" tip_link="robot2_tool0" />
  </group>
  <group_state name="home" group="robot2">
    <joint name="robot2_joint1" value="0.09" />
    <joint name="robot2_joint2" value="0.0" />
    <joint name="robot2_joint3" value="0.0" />
  </group_state>
  <disable_collisions link1="robot2_base_link" link2="robot2_link1" reason="Adjacent" />
  <disable_collisions link1="robot2_link1" link2="robot2_link2" reason="Adjacent" />
  <disable_collisions link1="robot2_link2" link2="robot2_link3" reason="Adjacent" />
  <disable_collisions link1="robot2_link3" link2="robot2_link4" reason="Adjacent" />
  <disable_collisions link1="robot2_link4" link2="robot2_link5" reason="Adjacent" />
  <group name="both_arms">
    <group name="robot1" />
    <group name="robot2" />
  </group>
</robot>